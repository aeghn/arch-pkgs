#!/usr/bin/env bash

# ep <KEYWORD> [EXLUDE_MODULE...] -- Enable Pattern
# e <FULLNAME> -- Enable Fixed
# dp <KEYWORD> [EXLUDE_MODULE...] -- Disable Pattern
# d <FULLNAME> -- Disable Fixed

e() { scripts/config --enable "$1" || exit 1; }

d() { scripts/config --disable "$1" || exit 1; }

dp() {
    local pattern="$1"
    shift

    local tmpfile=/tmp/.kernel.config
    cp .config "${tmpfile}"

    local ex=()
    for i in "$@"; do
        ex=(${ex[@]} -e "/$i/d")
    done

    cat "${tmpfile}" | grep -v "^#" | grep "$pattern" | sed -e "s/1/1/g" ${ex[@]} | while read line; do
        scripts/config --disable "$line" || exit 1
    done
}

